<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.nowtifried">

    <!-- Permission for Android 13+ to post notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="nowtifried"
        android:icon="@mipmap/ic_launcher">
        <receiver android:name="com.example.nowtifried.NowtifriedWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/nowtifried_widget_info" />
        </receiver>
    </application>
</manifest>
