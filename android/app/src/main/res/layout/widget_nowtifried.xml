<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/widget_root"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:adjustViewBounds="false"
        android:contentDescription="Nowtifried Widget" />

    <!-- Interactive Day Touch Overlay for Schedule Widget (hidden for other widget types) -->
    <LinearLayout
        android:id="@+id/day_strip_touch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="100"
        android:baselineAligned="false"
        android:visibility="gone">

        <!-- Top Touch Area (Tapping hero card launches schedule in app) -->
        <FrameLayout
            android:id="@+id/touch_top_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="44"
            android:clickable="true"
            android:focusable="true" />

        <!-- Day Strip Click Row (Tapping Mon-Sat switches day in-place on home screen) -->
        <LinearLayout
            android:id="@+id/day_buttons_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="16"
            android:orientation="horizontal"
            android:weightSum="6"
            android:clickable="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/btn_day_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_day_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_day_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_day_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_day_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_day_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Bottom Touch Area (Tapping subject chips launches timetable in app) -->
        <FrameLayout
            android:id="@+id/touch_bottom_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="40"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</FrameLayout>
